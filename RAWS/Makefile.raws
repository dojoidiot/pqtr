# RAWS Library Makefile
# Builds lib/RAWS.a static library
#
# Exposes:
#   - sony::Decoder (Sony ARW RAW decoder)

# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# OpenCV paths (RAWS depends on LABS for OpenCV)
OPENCV_ROOT = ../LABS/lib/opencv
OPENCV_INCLUDE = -I$(OPENCV_ROOT)/build \
                 -I$(OPENCV_ROOT)/modules/core/include \
                 -I$(OPENCV_ROOT)/modules/imgproc/include \
                 -I$(OPENCV_ROOT)/modules/imgcodecs/include

# Include paths
INCLUDES = $(OPENCV_INCLUDE) \
           -I./inc \
           -I./src/main/part \
           -I../LABS/inc

# Directories
SRC_DIR = src/main
TMP_DIR = tmp/libs
OBJ_DIR = $(TMP_DIR)/obj
LIB_DIR = lib

# Sony decoder sources (part)
SONY_SRCS = $(SRC_DIR)/part/sony.cpp \
            $(SRC_DIR)/part/sony/prepare.cpp \
            $(SRC_DIR)/part/sony/process.cpp \
            $(SRC_DIR)/part/sony/blc.cpp \
            $(SRC_DIR)/part/sony/blc_bayer.cpp \
            $(SRC_DIR)/part/sony/wb_gain.cpp \
            $(SRC_DIR)/part/sony/wb_bayer.cpp \
            $(SRC_DIR)/part/sony/demosaic.cpp \
            $(SRC_DIR)/part/sony/color_matrix.cpp \
            $(SRC_DIR)/part/sony/undistort.cpp \
            $(SRC_DIR)/part/sony/crop.cpp \
            $(SRC_DIR)/part/sony/gamma_oetf.cpp

# RAWS API sources
RAWS_SRCS = $(SRC_DIR)/raws.cpp

# Object files
SONY_OBJS = $(OBJ_DIR)/sony/sony.o \
            $(OBJ_DIR)/sony/prepare.o \
            $(OBJ_DIR)/sony/process.o \
            $(OBJ_DIR)/sony/blc.o \
            $(OBJ_DIR)/sony/blc_bayer.o \
            $(OBJ_DIR)/sony/wb_gain.o \
            $(OBJ_DIR)/sony/wb_bayer.o \
            $(OBJ_DIR)/sony/demosaic.o \
            $(OBJ_DIR)/sony/color_matrix.o \
            $(OBJ_DIR)/sony/undistort.o \
            $(OBJ_DIR)/sony/crop.o \
            $(OBJ_DIR)/sony/gamma_oetf.o

RAWS_OBJS = $(OBJ_DIR)/raws.o

ALL_OBJS = $(RAWS_OBJS) $(SONY_OBJS)

# Target static library
RAWS_A = $(LIB_DIR)/RAWS.a

.PHONY: all clean info

all: $(RAWS_A)

$(RAWS_A): $(ALL_OBJS) | $(LIB_DIR)
	ar rcs $@ $^
	@echo "Built: $@"

# RAWS API object
$(OBJ_DIR)/raws.o: $(SRC_DIR)/raws.cpp | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Sony decoder object
$(OBJ_DIR)/sony/sony.o: $(SRC_DIR)/part/sony.cpp | $(OBJ_DIR)/sony
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Sony submodule objects
$(OBJ_DIR)/sony/%.o: $(SRC_DIR)/part/sony/%.cpp | $(OBJ_DIR)/sony
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Directory creation
$(LIB_DIR):
	mkdir -p $(LIB_DIR)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(OBJ_DIR)/sony:
	mkdir -p $(OBJ_DIR)/sony

clean:
	rm -rf $(TMP_DIR) $(RAWS_A)

info:
	@echo "Target: $(RAWS_A)"
	@echo "Objects: $(ALL_OBJS)"
	@echo "OpenCV: $(OPENCV_ROOT)"
