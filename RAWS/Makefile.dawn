# RAWS DAWN Shader Tests Makefile
#
# Usage:
#   make -f Makefile.dawn test    # Build and run tests
#   make -f Makefile.dawn clean   # Clean build artifacts

CXX = g++
CXXFLAGS = -std=c++17 -O2 -Wall -Wno-strict-aliasing

# Dawn paths
DAWN_DIR = ../DAWN
DAWN_SRC = $(DAWN_DIR)/lib/dawn
DAWN_BUILD = $(DAWN_SRC)/out/Release

DAWN_INC = -I$(DAWN_DIR)/inc \
           -I$(DAWN_SRC)/include \
           -I$(DAWN_BUILD)/gen/include

# Test paths
TEST_DIR = src/test/dawn
TEST_BIN = tmp/test/test_dawn
OBJ_DIR = tmp/obj/dawn

# Sources
TEST_SRCS = $(wildcard $(TEST_DIR)/*.cpp)
TEST_OBJS = $(TEST_SRCS:$(TEST_DIR)/%.cpp=$(OBJ_DIR)/%.o)

# Dawn libs
DAWN_WRAPPER = $(DAWN_DIR)/tmp/dawn.o
DAWN_ALL_LIBS = $(shell find $(DAWN_BUILD) -name "*.a" 2>/dev/null)
DAWN_SYS_LIBS = -lvulkan -ldl -lpthread -lX11

.PHONY: test clean

test: $(TEST_BIN)
	$(TEST_BIN)

$(TEST_BIN): $(TEST_OBJS)
	@mkdir -p tmp/test
	$(CXX) $(CXXFLAGS) $(TEST_OBJS) \
		$(DAWN_WRAPPER) \
		-Wl,--start-group $(DAWN_ALL_LIBS) -Wl,--end-group \
		$(DAWN_SYS_LIBS) \
		-o $@

$(OBJ_DIR)/%.o: $(TEST_DIR)/%.cpp
	@mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(DAWN_INC) -I$(TEST_DIR) -c $< -o $@

clean:
	rm -rf tmp/test/test_dawn tmp/obj/dawn
