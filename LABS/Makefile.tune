# Tune Makefile
# Builds bin/tune, bin/labs, and tests
#
# Usage:
#   make -f Makefile.tune           # Build bin/tune, bin/labs, and tests
#   make -f Makefile.tune tune      # Build bin/tune only
#   make -f Makefile.tune labs      # Build bin/labs only
#   make -f Makefile.tune test-fast # Run fast geos test
#   make -f Makefile.tune test-full # Run full geos test (takes ~60s)
#   make -f Makefile.tune test-rnd  # Run R&D harness (outputs to tmp/var/tune/)

# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# OpenCV paths
OPENCV_ROOT = ./lib/opencv
OPENCV_INCLUDE = -I$(OPENCV_ROOT)/build \
                 -I$(OPENCV_ROOT)/modules/core/include \
                 -I$(OPENCV_ROOT)/modules/imgproc/include \
                 -I$(OPENCV_ROOT)/modules/imgcodecs/include
OPENCV_LIB = $(OPENCV_ROOT)/build/lib

# Include paths
INCLUDES = $(OPENCV_INCLUDE) -I./inc -I./src/main/part/geos -I./src/main/part/pipe

# Library flags - static OpenCV linking (no LD_LIBRARY_PATH needed at runtime)
OPENCV_STATIC = $(OPENCV_LIB)/libopencv_imgcodecs.a \
                $(OPENCV_LIB)/libopencv_imgproc.a \
                $(OPENCV_LIB)/libopencv_core.a
LDFLAGS = -L./lib
LIBS = ./lib/labs.a $(OPENCV_STATIC) -lpng -ljpeg -lz -lGL -ldl -lpthread

# Directories
MAIN_SRC = src/main
TEST_SRC = src/test/geos
OBJ_DIR = tmp/obj/tune
BIN_DIR = bin
TEST_BIN_DIR = tmp/bin/tune
VAR_DIR = tmp/var/tune

# Binary sources
TUNE_SRC = $(MAIN_SRC)/tune.cpp
TUNE_OBJ = $(OBJ_DIR)/tune.o
TUNE_BIN = $(BIN_DIR)/tune

LABS_SRC = $(MAIN_SRC)/labs.cpp
LABS_OBJ = $(OBJ_DIR)/labs.o
LABS_BIN = $(BIN_DIR)/labs

# Test sources
FAST_SRC = $(TEST_SRC)/fast.cpp
FAST_OBJ = $(OBJ_DIR)/fast.o
FAST_BIN = $(TEST_BIN_DIR)/tune-fast

FULL_SRC = $(TEST_SRC)/full.cpp
FULL_OBJ = $(OBJ_DIR)/full.o
FULL_BIN = $(TEST_BIN_DIR)/tune-full

TUNE_TEST_SRC = $(TEST_SRC)/tune.cpp
TUNE_TEST_OBJ = $(OBJ_DIR)/tune_test.o
TUNE_TEST_BIN = $(TEST_BIN_DIR)/tune-test

BATCH_SRC = $(TEST_SRC)/batch.cpp
BATCH_OBJ = $(OBJ_DIR)/batch.o
BATCH_BIN = $(TEST_BIN_DIR)/batch

DIAG_SRC = $(TEST_SRC)/diag.cpp
DIAG_OBJ = $(OBJ_DIR)/diag.o
DIAG_BIN = $(TEST_BIN_DIR)/diag

TRAIN_SRC = $(TEST_SRC)/train.cpp
TRAIN_OBJ = $(OBJ_DIR)/train.o
TRAIN_BIN = $(TEST_BIN_DIR)/train

# Test input
TEST_RAW = var/pics/DSC00202.ARW

.PHONY: all clean tune labs gold test-fast test-full test test-rnd test-labs test-batch diag train batch-tune train-greedy train-prms train-exhaustive sweep bounds jacob axis-balance test-gold

LABS_VAR_DIR = tmp/var/labs

all: $(TUNE_BIN) $(LABS_BIN) $(FAST_BIN) $(FULL_BIN) $(TUNE_TEST_BIN) $(BATCH_BIN)

tune: $(TUNE_BIN)

labs: $(LABS_BIN)

# Main tune binary
$(TUNE_BIN): $(TUNE_OBJ) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TUNE_OBJ): $(TUNE_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Main labs binary
$(LABS_BIN): $(LABS_OBJ) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(LABS_OBJ): $(LABS_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Tune-fast test binary
$(FAST_BIN): $(FAST_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(FAST_OBJ): $(FAST_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Tune-full test binary
$(FULL_BIN): $(FULL_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(FULL_OBJ): $(FULL_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Tune-test binary (original test harness)
$(TUNE_TEST_BIN): $(TUNE_TEST_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TUNE_TEST_OBJ): $(TUNE_TEST_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Directory creation
$(BIN_DIR):
	mkdir -p $(BIN_DIR)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(TEST_BIN_DIR):
	mkdir -p $(TEST_BIN_DIR)

clean:
	rm -rf $(OBJ_DIR) $(TEST_BIN_DIR) $(VAR_DIR) $(TUNE_BIN) $(LABS_BIN)

# Run fast test (linear-only mode, ~10s)
test-fast: $(FAST_BIN)
	@mkdir -p $(VAR_DIR)
	@echo "=== Tune Fast Test ==="
	$(FAST_BIN) $(TEST_RAW) $(VAR_DIR)

# Run full test (blockwise mode, ~60s)
test-full: $(FULL_BIN)
	@mkdir -p $(VAR_DIR)
	@echo "=== Tune Full Test ==="
	$(FULL_BIN) $(TEST_RAW) $(VAR_DIR)

# Default test
test: test-fast

# R&D test harness (full pipeline with all outputs to tmp/var/tune/)
test-rnd: $(TUNE_TEST_BIN)
	@mkdir -p $(VAR_DIR)
	@echo "=== Tune R&D Test Harness ==="
	$(TUNE_TEST_BIN)

# Run labs test (applies tune.json to source RAW)
test-labs: $(LABS_BIN)
	@mkdir -p $(LABS_VAR_DIR)
	@echo "=== Labs Test ==="
	$(LABS_BIN) $(TEST_RAW) --tune $(VAR_DIR)/tune.json --output $(LABS_VAR_DIR)/tail.png --size 1080

# Batch binary
$(BATCH_BIN): $(BATCH_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(BATCH_OBJ): $(BATCH_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Batch test (tune each ARW to its JPEG, create comparison grid)
test-batch: $(BATCH_BIN)
	@echo "=== Batch Test (this will take a while) ==="
	$(BATCH_BIN)

# Diagnostic binary
$(DIAG_BIN): $(DIAG_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(DIAG_OBJ): $(DIAG_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Run diagnostic (analyze per-feature errors across all images)
diag: $(DIAG_BIN)
	@echo "=== Feature Loss Diagnostic ==="
	$(DIAG_BIN)

# Training binary
$(TRAIN_BIN): $(TRAIN_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TRAIN_OBJ): $(TRAIN_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Run weight training (analyze errors and suggest optimal weights)
train: $(TRAIN_BIN)
	@echo "=== Weight Training ==="
	$(TRAIN_BIN)

# Batch tune all images (run before train)
batch-tune:
	@echo "=== Batch Tune (all images) ==="
	@mkdir -p tmp/var/pics
	@for img in var/pics/*.ARW; do \
		name=$$(basename "$$img" .ARW); \
		echo "Processing $$name..."; \
		mkdir -p "tmp/var/pics/$$name"; \
		timeout 600 $(TUNE_BIN) "$$img" preview \
			--save-area "tmp/var/pics/$$name" \
			--fine --fine-area "tmp/var/pics/$$name" \
			--mode blockwise --optimizer spsa 2>&1 | tail -3; \
	done
	@echo "=== Batch complete ==="

# Greedy training sources
GREEDY_SRC = $(TEST_SRC)/train_greedy.cpp
GREEDY_OBJ = $(OBJ_DIR)/train_greedy.o
GREEDY_BIN = $(TEST_BIN_DIR)/train_greedy

# Phase params training sources
PRMS_SRC = $(TEST_SRC)/train_prms.cpp
PRMS_OBJ = $(OBJ_DIR)/train_prms.o
PRMS_BIN = $(TEST_BIN_DIR)/train_prms

# Greedy training binary
$(GREEDY_BIN): $(GREEDY_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(GREEDY_OBJ): $(GREEDY_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Phase params training binary
$(PRMS_BIN): $(PRMS_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(PRMS_OBJ): $(PRMS_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Greedy training: rank images, analyze worst, suggest weights
train-greedy: $(GREEDY_BIN)
	@echo "=== Greedy Training (worst-first optimization) ==="
	$(GREEDY_BIN)

# Phase params training: grid search a0/c0 for optimal SPSA params
train-prms: $(PRMS_BIN)
	@echo "=== Phase Params Training (SPSA hyperparameters) ==="
	$(PRMS_BIN)

# Exhaustive training sources
EXHAUSTIVE_SRC = $(TEST_SRC)/train_exhaustive.cpp
EXHAUSTIVE_OBJ = $(OBJ_DIR)/train_exhaustive.o
EXHAUSTIVE_BIN = $(TEST_BIN_DIR)/train_exhaustive

# Sweep diagnostic sources
SWEEP_SRC = $(TEST_SRC)/sweep.cpp
SWEEP_OBJ = $(OBJ_DIR)/sweep.o
SWEEP_BIN = $(TEST_BIN_DIR)/sweep

# Exhaustive training binary
$(EXHAUSTIVE_BIN): $(EXHAUSTIVE_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(EXHAUSTIVE_OBJ): $(EXHAUSTIVE_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Sweep diagnostic binary
$(SWEEP_BIN): $(SWEEP_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(SWEEP_OBJ): $(SWEEP_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Exhaustive training: no time limit, find global optimum
train-exhaustive: $(EXHAUSTIVE_BIN)
	@echo "=== Exhaustive Training (unlimited time) ==="
	$(EXHAUSTIVE_BIN)

# Sweep diagnostic: understand loss landscape for individual dials
sweep: $(SWEEP_BIN)
	@echo "=== Dial Sweep Diagnostic ==="
	$(SWEEP_BIN)

# Bounds diagnostic sources
BOUNDS_SRC = $(TEST_SRC)/bounds.cpp
BOUNDS_OBJ = $(OBJ_DIR)/bounds.o
BOUNDS_BIN = $(TEST_BIN_DIR)/bounds

$(BOUNDS_BIN): $(BOUNDS_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(BOUNDS_OBJ): $(BOUNDS_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Bounds diagnostic: find achievable feature min/max
bounds: $(BOUNDS_BIN)
	@echo "=== Feature Bounds Diagnostic ==="
	$(BOUNDS_BIN)

# Jacobian estimation sources
JACOB_SRC = $(TEST_SRC)/jacob.cpp
JACOB_OBJ = $(OBJ_DIR)/jacob.o
JACOB_BIN = $(TEST_BIN_DIR)/jacob

$(JACOB_BIN): $(JACOB_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(JACOB_OBJ): $(JACOB_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Jacobian: estimate dial→feature sensitivity matrix
jacob: $(JACOB_BIN)
	@echo "=== Jacobian Estimation ==="
	$(JACOB_BIN)

# Axis balance test sources (Hypothesis 3)
AXIS_SRC = $(TEST_SRC)/axis_balance.cpp
AXIS_OBJ = $(OBJ_DIR)/axis_balance.o
AXIS_BIN = $(TEST_BIN_DIR)/axis_balance

$(AXIS_BIN): $(AXIS_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(AXIS_OBJ): $(AXIS_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Axis balance: test opponent-axis contrast preservation
axis-balance: $(AXIS_BIN)
	@echo "=== Axis Balance Test (Hypothesis 3) ==="
	$(AXIS_BIN)

# Gold binary (stage-aware optimizer test)
GOLD_SRC = $(MAIN_SRC)/gold.cpp
GOLD_OBJ = $(OBJ_DIR)/gold.o
GOLD_BIN = $(BIN_DIR)/gold

$(GOLD_BIN): $(GOLD_OBJ) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(GOLD_OBJ): $(GOLD_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

gold: $(GOLD_BIN)

# Run gold on DSC00144 (the hard image)
test-gold: $(GOLD_BIN)
	@mkdir -p $(VAR_DIR)
	@echo "=== Gold Test (Stage-Aware Optimizer) ==="
	$(GOLD_BIN) var/pics/DSC00144.ARW preview --save-area $(VAR_DIR)

# Vibe binary (neural dial predictor)
VIBE_SRC = $(MAIN_SRC)/vibe.cpp
VIBE_OBJ = $(OBJ_DIR)/vibe.o
VIBE_BIN = $(BIN_DIR)/vibe

$(VIBE_BIN): $(VIBE_OBJ) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) -fopenmp $(LDFLAGS) -o $@ $^ $(LIBS)

$(VIBE_OBJ): $(VIBE_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -fopenmp $(INCLUDES) -c $< -o $@

vibe: $(VIBE_BIN)

# Extract training data from pics
vibe-extract: $(VIBE_BIN)
	@mkdir -p tmp/var/vibe
	@echo "=== Vibe Extract (features from 537 pairs) ==="
	$(VIBE_BIN) extract /home/z/base/pics --out tmp/var/vibe/train.json

# Train vibe model
vibe-train: $(VIBE_BIN)
	@echo "=== Vibe Train (MLP on extracted data) ==="
	$(VIBE_BIN) train tmp/var/vibe/train.json --out etc/camera.vibe
