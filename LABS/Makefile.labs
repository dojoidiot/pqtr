# LABS Library Makefile
# Builds lib/labs.a static library
#
# Exposes:
#   - sony::Decoder (via RAWS library)
#   - pipe::mods::* (processing modules)
#   - tune::Task (optimization)
#   - pqtr::Sink, pqtr::Tool, pqtr::Hold (infrastructure, header-only)

# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# OpenCV paths
OPENCV_ROOT = ./lib/opencv
OPENCV_INCLUDE = -I$(OPENCV_ROOT)/build \
                 -I$(OPENCV_ROOT)/modules/core/include \
                 -I$(OPENCV_ROOT)/modules/imgproc/include \
                 -I$(OPENCV_ROOT)/modules/imgcodecs/include
OPENCV_LIB = $(OPENCV_ROOT)/build/lib

# Include paths
INCLUDES = $(OPENCV_INCLUDE) \
           -I./inc \
           -I./inc/RAWS \
           -I./src/main/part/pipe \
           -I./src/main/part/tune

# Directories
SRC_DIR = src/main
TMP_DIR = tmp/libs
OBJ_DIR = $(TMP_DIR)/obj
LIB_DIR = lib

# RAWS library (via wire.sh symlink)
RAWS_A = $(LIB_DIR)/RAWS.a

# Pipe sources (HEAD/BODY/TAIL + internal)
PIPE_SRCS = $(SRC_DIR)/part/pipe/pipe.cpp \
            $(SRC_DIR)/part/pipe/view.cpp \
            $(SRC_DIR)/part/pipe/link.cpp

# Module sources (processing)
MODS_SRCS = $(SRC_DIR)/part/pipe/mods/color_matrix.cpp \
            $(SRC_DIR)/part/pipe/mods/exposure.cpp \
            $(SRC_DIR)/part/pipe/mods/white_balance.cpp \
            $(SRC_DIR)/part/pipe/mods/tone_map.cpp \
            $(SRC_DIR)/part/pipe/mods/global_color.cpp \
            $(SRC_DIR)/part/pipe/mods/selective_color.cpp \
            $(SRC_DIR)/part/pipe/mods/geometric.cpp \
            $(SRC_DIR)/part/pipe/mods/detail.cpp \
            $(SRC_DIR)/part/pipe/mods/lut_curve.cpp

# Tune sources (optimization + loss metrics + serialization)
TUNE_SRCS = $(SRC_DIR)/part/tune/tune.cpp \
            $(SRC_DIR)/part/tune/diff.cpp \
            $(SRC_DIR)/part/tune/geos.cpp \
            $(SRC_DIR)/part/tune/edge.cpp \
            $(SRC_DIR)/part/tune/data.cpp

# Object files
PIPE_OBJS = $(OBJ_DIR)/pipe/pipe.o \
            $(OBJ_DIR)/pipe/view.o \
            $(OBJ_DIR)/pipe/link.o

MODS_OBJS = $(OBJ_DIR)/mods/color_matrix.o \
            $(OBJ_DIR)/mods/exposure.o \
            $(OBJ_DIR)/mods/white_balance.o \
            $(OBJ_DIR)/mods/tone_map.o \
            $(OBJ_DIR)/mods/global_color.o \
            $(OBJ_DIR)/mods/selective_color.o \
            $(OBJ_DIR)/mods/geometric.o \
            $(OBJ_DIR)/mods/detail.o \
            $(OBJ_DIR)/mods/lut_curve.o

TUNE_OBJS = $(OBJ_DIR)/tune/tune.o \
            $(OBJ_DIR)/tune/diff.o \
            $(OBJ_DIR)/tune/geos.o \
            $(OBJ_DIR)/tune/edge.o \
            $(OBJ_DIR)/tune/data.o

ALL_OBJS = $(PIPE_OBJS) $(MODS_OBJS) $(TUNE_OBJS)

# Target static library
LABS_A = $(LIB_DIR)/labs.a

.PHONY: all clean info

all: $(LABS_A)

# Combine LABS objects with RAWS library into labs.a
$(LABS_A): $(ALL_OBJS) $(RAWS_A) | $(LIB_DIR)
	@rm -rf $(TMP_DIR)/merge && mkdir -p $(TMP_DIR)/merge
	cd $(TMP_DIR)/merge && ar x ../../../$(RAWS_A)
	ar rcs $@ $(ALL_OBJS) $(TMP_DIR)/merge/*.o
	@rm -rf $(TMP_DIR)/merge
	@echo "Built: $@ (includes RAWS)"

# Pipe objects
$(OBJ_DIR)/pipe/%.o: $(SRC_DIR)/part/pipe/%.cpp | $(OBJ_DIR)/pipe
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Module objects
$(OBJ_DIR)/mods/%.o: $(SRC_DIR)/part/pipe/mods/%.cpp | $(OBJ_DIR)/mods
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Tune objects
$(OBJ_DIR)/tune/%.o: $(SRC_DIR)/part/tune/%.cpp | $(OBJ_DIR)/tune
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Directory creation
$(LIB_DIR):
	mkdir -p $(LIB_DIR)

$(OBJ_DIR)/pipe:
	mkdir -p $(OBJ_DIR)/pipe

$(OBJ_DIR)/mods:
	mkdir -p $(OBJ_DIR)/mods

$(OBJ_DIR)/tune:
	mkdir -p $(OBJ_DIR)/tune

clean:
	rm -rf $(TMP_DIR) $(LABS_A)

info:
	@echo "Target: $(LABS_A)"
	@echo "Objects: $(ALL_OBJS)"
	@echo "RAWS: $(RAWS_A)"
	@echo "OpenCV: $(OPENCV_LIB)"
