# Test Makefile
# Builds unit tests for pipe modules

# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# OpenCV paths
OPENCV_ROOT = ./lib/opencv
OPENCV_INCLUDE = -I$(OPENCV_ROOT)/build \
                 -I$(OPENCV_ROOT)/modules/core/include \
                 -I$(OPENCV_ROOT)/modules/imgproc/include \
                 -I$(OPENCV_ROOT)/modules/imgcodecs/include
OPENCV_LIB = $(OPENCV_ROOT)/build/lib

# Include paths
INCLUDES = $(OPENCV_INCLUDE) -I./inc -I./src/main/part

# Library flags
LDFLAGS = -L$(OPENCV_LIB)
LIBS = -lopencv_core -lopencv_imgproc -lopencv_imgcodecs -Wl,-rpath,$(OPENCV_LIB)

# Directories
SRC_DIR = src
TEST_DIR = $(SRC_DIR)/test
MODS_DIR = $(SRC_DIR)/main/part/pipe/mods
TMP_DIR = tmp/test
BIN_DIR = $(TMP_DIR)/bin
OBJ_DIR = $(TMP_DIR)/obj

# Module sources (shared with main build)
MODS_SRCS = $(MODS_DIR)/tone_map.cpp \
            $(MODS_DIR)/color_matrix.cpp \
            $(MODS_DIR)/exposure.cpp \
            $(MODS_DIR)/white_balance.cpp \
            $(MODS_DIR)/global_color.cpp \
            $(MODS_DIR)/selective_color.cpp \
            $(MODS_DIR)/geometric.cpp \
            $(MODS_DIR)/detail.cpp
MODS_OBJS = $(OBJ_DIR)/mods/tone_map.o \
            $(OBJ_DIR)/mods/color_matrix.o \
            $(OBJ_DIR)/mods/exposure.o \
            $(OBJ_DIR)/mods/white_balance.o \
            $(OBJ_DIR)/mods/global_color.o \
            $(OBJ_DIR)/mods/selective_color.o \
            $(OBJ_DIR)/mods/geometric.o \
            $(OBJ_DIR)/mods/detail.o

# Test sources and targets
TEST_TONE_MAP_SRC = $(TEST_DIR)/mods/test_tone_map.cpp
TEST_TONE_MAP_OBJ = $(OBJ_DIR)/test_tone_map.o
TEST_TONE_MAP_BIN = $(BIN_DIR)/test_tone_map

TEST_EXPOSURE_SRC = $(TEST_DIR)/mods/test_exposure.cpp
TEST_EXPOSURE_OBJ = $(OBJ_DIR)/test_exposure.o
TEST_EXPOSURE_BIN = $(BIN_DIR)/test_exposure

TEST_WHITE_BALANCE_SRC = $(TEST_DIR)/mods/test_white_balance.cpp
TEST_WHITE_BALANCE_OBJ = $(OBJ_DIR)/test_white_balance.o
TEST_WHITE_BALANCE_BIN = $(BIN_DIR)/test_white_balance

GEN_TEST_IMAGES_SRC = $(TEST_DIR)/mods/gen_test_images.cpp
GEN_TEST_IMAGES_OBJ = $(OBJ_DIR)/gen_test_images.o
GEN_TEST_IMAGES_BIN = $(BIN_DIR)/gen_test_images

TEST_GLOBAL_COLOR_SRC = $(TEST_DIR)/mods/test_global_color.cpp
TEST_GLOBAL_COLOR_OBJ = $(OBJ_DIR)/test_global_color.o
TEST_GLOBAL_COLOR_BIN = $(BIN_DIR)/test_global_color

TEST_SELECTIVE_COLOR_SRC = $(TEST_DIR)/mods/test_selective_color.cpp
TEST_SELECTIVE_COLOR_OBJ = $(OBJ_DIR)/test_selective_color.o
TEST_SELECTIVE_COLOR_BIN = $(BIN_DIR)/test_selective_color

TEST_GEOMETRIC_SRC = $(TEST_DIR)/mods/test_geometric.cpp
TEST_GEOMETRIC_OBJ = $(OBJ_DIR)/test_geometric.o
TEST_GEOMETRIC_BIN = $(BIN_DIR)/test_geometric

TEST_DETAIL_SRC = $(TEST_DIR)/mods/test_detail.cpp
TEST_DETAIL_OBJ = $(OBJ_DIR)/test_detail.o
TEST_DETAIL_BIN = $(BIN_DIR)/test_detail

# Test data
TEST_DATA_DIR = tmp/var/test/data
TEST_OUTPUT_DIR = tmp/var/test/output

.PHONY: all clean test test-tone-map test-exposure test-white-balance test-global-color test-selective-color test-geometric test-detail gen-test-data

all: $(TEST_TONE_MAP_BIN) $(TEST_EXPOSURE_BIN) $(TEST_WHITE_BALANCE_BIN) $(TEST_GLOBAL_COLOR_BIN) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_GEOMETRIC_BIN) $(TEST_DETAIL_BIN) $(GEN_TEST_IMAGES_BIN)

# Build test executables
$(TEST_TONE_MAP_BIN): $(TEST_TONE_MAP_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TEST_EXPOSURE_BIN): $(TEST_EXPOSURE_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TEST_WHITE_BALANCE_BIN): $(TEST_WHITE_BALANCE_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(GEN_TEST_IMAGES_BIN): $(GEN_TEST_IMAGES_OBJ) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TEST_GLOBAL_COLOR_BIN): $(TEST_GLOBAL_COLOR_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TEST_SELECTIVE_COLOR_BIN): $(TEST_SELECTIVE_COLOR_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TEST_GEOMETRIC_BIN): $(TEST_GEOMETRIC_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(TEST_DETAIL_BIN): $(TEST_DETAIL_OBJ) $(MODS_OBJS) | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

# Compile test sources
$(OBJ_DIR)/test_tone_map.o: $(TEST_TONE_MAP_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/test_exposure.o: $(TEST_EXPOSURE_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/test_white_balance.o: $(TEST_WHITE_BALANCE_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/gen_test_images.o: $(GEN_TEST_IMAGES_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/test_global_color.o: $(TEST_GLOBAL_COLOR_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/test_selective_color.o: $(TEST_SELECTIVE_COLOR_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/test_geometric.o: $(TEST_GEOMETRIC_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/test_detail.o: $(TEST_DETAIL_SRC) | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Compile module sources
$(OBJ_DIR)/mods/%.o: $(MODS_DIR)/%.cpp | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Directories
$(BIN_DIR):
	mkdir -p $(BIN_DIR)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

clean:
	rm -rf $(TMP_DIR)

# Generate synthetic test data
gen-test-data: $(GEN_TEST_IMAGES_BIN)
	@mkdir -p $(TEST_DATA_DIR)
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(GEN_TEST_IMAGES_BIN) $(TEST_DATA_DIR)

# Run tests
test: gen-test-data test-tone-map test-exposure test-white-balance test-global-color test-selective-color test-geometric test-detail

test-tone-map: $(TEST_TONE_MAP_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: tone_map (all neutral) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_TONE_MAP_BIN) $(TEST_DATA_DIR)/tone_map_hdr_ramp.png $(TEST_OUTPUT_DIR)/tone_map_neutral.png 0.5 0.5 0.5 0.5 0.5
	@echo ""
	@echo "=== Test: tone_map (high contrast) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_TONE_MAP_BIN) $(TEST_DATA_DIR)/tone_map_hdr_ramp.png $(TEST_OUTPUT_DIR)/tone_map_contrast.png 0.75 0.5 0.5 0.5 0.5
	@echo ""
	@echo "=== Test: tone_map (lifted shadows) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_TONE_MAP_BIN) $(TEST_DATA_DIR)/tone_map_hdr_ramp.png $(TEST_OUTPUT_DIR)/tone_map_shadows_up.png 0.5 0.5 0.75 0.5 0.5
	@echo ""
	@echo "=== Test: tone_map (crushed shadows) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_TONE_MAP_BIN) $(TEST_DATA_DIR)/tone_map_hdr_ramp.png $(TEST_OUTPUT_DIR)/tone_map_shadows_down.png 0.5 0.5 0.25 0.5 0.5
	@echo ""
	@echo "=== Test: tone_map (compressed highlights) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_TONE_MAP_BIN) $(TEST_DATA_DIR)/tone_map_ev_patches.png $(TEST_OUTPUT_DIR)/tone_map_highlights_down.png 0.5 0.25 0.5 0.5 0.5
	@echo ""
	@echo "=== Test: tone_map (expanded highlights) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_TONE_MAP_BIN) $(TEST_DATA_DIR)/tone_map_ev_patches.png $(TEST_OUTPUT_DIR)/tone_map_highlights_up.png 0.5 0.75 0.5 0.5 0.5

test-exposure: $(TEST_EXPOSURE_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: exposure (gray ramp, neutral EV=0) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_EXPOSURE_BIN) $(TEST_DATA_DIR)/exposure_ramp.png $(TEST_OUTPUT_DIR)/exposure_neutral.png 0.5
	@echo ""
	@echo "=== Test: exposure (midgray, -2 EV) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_EXPOSURE_BIN) $(TEST_DATA_DIR)/exposure_midgray.png $(TEST_OUTPUT_DIR)/exposure_dark.png 0.25
	@echo ""
	@echo "=== Test: exposure (midgray, +2 EV) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_EXPOSURE_BIN) $(TEST_DATA_DIR)/exposure_midgray.png $(TEST_OUTPUT_DIR)/exposure_bright.png 0.75
	@echo ""
	@echo "=== Test: exposure (gray ramp, -4 EV) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_EXPOSURE_BIN) $(TEST_DATA_DIR)/exposure_ramp.png $(TEST_OUTPUT_DIR)/exposure_very_dark.png 0.0
	@echo ""
	@echo "=== Test: exposure (gray ramp, +4 EV) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_EXPOSURE_BIN) $(TEST_DATA_DIR)/exposure_ramp.png $(TEST_OUTPUT_DIR)/exposure_very_bright.png 1.0

test-white-balance: $(TEST_WHITE_BALANCE_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: white_balance (color patches, neutral) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_WHITE_BALANCE_BIN) $(TEST_DATA_DIR)/white_balance_patches.png $(TEST_OUTPUT_DIR)/wb_neutral.png 0.5 0.5
	@echo ""
	@echo "=== Test: white_balance (color patches, warm 3000K) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_WHITE_BALANCE_BIN) $(TEST_DATA_DIR)/white_balance_patches.png $(TEST_OUTPUT_DIR)/wb_warm.png 0.25 0.5
	@echo ""
	@echo "=== Test: white_balance (color patches, cool 10000K) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_WHITE_BALANCE_BIN) $(TEST_DATA_DIR)/white_balance_patches.png $(TEST_OUTPUT_DIR)/wb_cool.png 0.75 0.5
	@echo ""
	@echo "=== Test: white_balance (colorchecker, green tint) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_WHITE_BALANCE_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/wb_green.png 0.5 0.25
	@echo ""
	@echo "=== Test: white_balance (colorchecker, magenta tint) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_WHITE_BALANCE_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/wb_magenta.png 0.5 0.75

test-global-color: $(TEST_GLOBAL_COLOR_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: global_color (neutral) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_neutral.png 0.5 0.5 0.5
	@echo ""
	@echo "=== Test: global_color (high vibrance) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_vibrance_up.png 0.75 0.5 0.5
	@echo ""
	@echo "=== Test: global_color (low vibrance) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_vibrance_down.png 0.25 0.5 0.5
	@echo ""
	@echo "=== Test: global_color (high saturation) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_saturation_up.png 0.5 0.75 0.5
	@echo ""
	@echo "=== Test: global_color (low saturation) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_saturation_down.png 0.5 0.25 0.5
	@echo ""
	@echo "=== Test: global_color (high color density) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_density_up.png 0.5 0.5 0.75
	@echo ""
	@echo "=== Test: global_color (low color density) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GLOBAL_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/gc_density_down.png 0.5 0.5 0.25

test-selective-color: $(TEST_SELECTIVE_COLOR_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: selective_color (neutral) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/sc_neutral.png 0 0.5 0.5 0.5
	@echo ""
	@echo "=== Test: selective_color (red hue shift +15°) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/sc_red_hue.png 0 0.75 0.5 0.5
	@echo ""
	@echo "=== Test: selective_color (red saturation boost) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/sc_red_sat.png 0 0.5 0.75 0.5
	@echo ""
	@echo "=== Test: selective_color (green saturation reduce) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/sc_green_desat.png 3 0.5 0.25 0.5
	@echo ""
	@echo "=== Test: selective_color (blue luminance boost) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/sc_blue_bright.png 5 0.5 0.5 0.75
	@echo ""
	@echo "=== Test: selective_color (orange hue shift -15°) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_SELECTIVE_COLOR_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/sc_orange_hue.png 1 0.25 0.5 0.5

test-geometric: $(TEST_GEOMETRIC_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: geometric (neutral) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GEOMETRIC_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/geo_neutral.png 0 0 0 0 0 0.5
	@echo ""
	@echo "=== Test: geometric (crop 10% all sides) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GEOMETRIC_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/geo_crop.png 0.2 0.2 0.2 0.2 0 0.5
	@echo ""
	@echo "=== Test: geometric (zoom 2x) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GEOMETRIC_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/geo_zoom.png 0 0 0 0 0.33 0.5
	@echo ""
	@echo "=== Test: geometric (rotate +15°) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GEOMETRIC_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/geo_rotate_cw.png 0 0 0 0 0 0.67
	@echo ""
	@echo "=== Test: geometric (rotate -15°) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GEOMETRIC_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/geo_rotate_ccw.png 0 0 0 0 0 0.33
	@echo ""
	@echo "=== Test: geometric (crop + zoom + rotate) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_GEOMETRIC_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/geo_combo.png 0.1 0.1 0.1 0.1 0.2 0.55

test-detail: $(TEST_DETAIL_BIN) gen-test-data
	@mkdir -p $(TEST_OUTPUT_DIR)
	@echo "=== Test: detail (neutral/no processing) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_DETAIL_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/detail_neutral.png 0 0 0 0
	@echo ""
	@echo "=== Test: detail (sharpen only) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_DETAIL_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/detail_sharpen.png 0.6 0.4 0 0
	@echo ""
	@echo "=== Test: detail (strong sharpen) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_DETAIL_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/detail_sharpen_strong.png 1.0 0.5 0 0
	@echo ""
	@echo "=== Test: detail (denoise luma only) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_DETAIL_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/detail_denoise_luma.png 0 0 0.5 0
	@echo ""
	@echo "=== Test: detail (denoise chroma only) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_DETAIL_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/detail_denoise_chroma.png 0 0 0 0.5
	@echo ""
	@echo "=== Test: detail (full default processing) ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(TEST_DETAIL_BIN) $(TEST_DATA_DIR)/colorchecker_srgb.png $(TEST_OUTPUT_DIR)/detail_default.png 0.6 0.4 0.3 0.5
