# Sony Test Makefile
# Builds sony test binaries
#
# Usage:
#   make -f Makefile.sony           # Build all test binaries
#   make -f Makefile.sony test      # Run sony decoder test
#   make -f Makefile.sony test-dist # Run distortion check

# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# OpenCV paths
OPENCV_ROOT = ../PIPE/lib/opencv
OPENCV_INCLUDE = -I$(OPENCV_ROOT)/build \
                 -I$(OPENCV_ROOT)/modules/core/include \
                 -I$(OPENCV_ROOT)/modules/imgproc/include \
                 -I$(OPENCV_ROOT)/modules/imgcodecs/include
OPENCV_LIB = $(OPENCV_ROOT)/build/lib

# Include paths
INCLUDES = $(OPENCV_INCLUDE) \
           -I./inc \
           -I./src/main/part \
           -I../PIPE/inc

# Library flags
LDFLAGS = -L$(OPENCV_LIB) -L./lib
LIBS = ./lib/RAWS.a -lopencv_core -lopencv_imgproc -lopencv_imgcodecs -Wl,-rpath,$(OPENCV_LIB)

# Directories
TEST_SRC = src/test/sony
TMP_DIR = tmp/obj/sony
TEST_BIN_DIR = tmp/bin/sony
VAR_DIR = tmp/var/sony

# Test sources
SONY_SRC = $(TEST_SRC)/sony.cpp
SONY_OBJ = $(TMP_DIR)/sony.o
SONY_BIN = $(TEST_BIN_DIR)/sony

DIST_SRC = $(TEST_SRC)/distortion.cpp
DIST_OBJ = $(TMP_DIR)/distortion.o
DIST_BIN = $(TEST_BIN_DIR)/distortion

# Test input
TEST_RAW = var/sony.ARW

.PHONY: all clean test test-dist

all: $(SONY_BIN) $(DIST_BIN)

# Sony decoder test binary
$(SONY_BIN): $(SONY_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(SONY_OBJ): $(SONY_SRC) | $(TMP_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Distortion check binary
$(DIST_BIN): $(DIST_OBJ) | $(TEST_BIN_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)

$(DIST_OBJ): $(DIST_SRC) | $(TMP_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Directory creation
$(TMP_DIR):
	mkdir -p $(TMP_DIR)

$(TEST_BIN_DIR):
	mkdir -p $(TEST_BIN_DIR)

clean:
	rm -rf $(TMP_DIR) $(TEST_BIN_DIR)

# Run sony decoder test
test: $(SONY_BIN)
	@mkdir -p $(VAR_DIR)
	@echo "=== Sony Decoder Test ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(SONY_BIN) $(TEST_RAW)

# Run distortion check
test-dist: $(DIST_BIN)
	@mkdir -p $(VAR_DIR)
	@echo "=== Distortion Check ==="
	LD_LIBRARY_PATH=$(OPENCV_LIB) $(DIST_BIN)
