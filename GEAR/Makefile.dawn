# GEAR WGPU Shader Tests Makefile (using Dawn backend)
#
# Usage:
#   make -f Makefile.dawn test    # Build and run tests
#   make -f Makefile.dawn clean   # Clean build artifacts

CXX = g++
CXXFLAGS = -std=c++17 -O2 -Wall -Wno-strict-aliasing

# WGPU paths (Dawn backend)
WGPU_DIR = ../WGPU
WGPU_SRC = $(WGPU_DIR)/lib/dawn
WGPU_BUILD = $(WGPU_SRC)/out/Release

WGPU_INC = -I$(WGPU_DIR)/inc \
           -I$(WGPU_SRC)/include \
           -I$(WGPU_BUILD)/gen/include

# Test paths
TEST_DIR = src/test/dawn
TEST_BIN = tmp/test/test_dawn
OBJ_DIR = tmp/obj/dawn

# Sources
TEST_SRCS = $(wildcard $(TEST_DIR)/*.cpp)
TEST_OBJS = $(TEST_SRCS:$(TEST_DIR)/%.cpp=$(OBJ_DIR)/%.o)

# Dawn libs
WGPU_WRAPPER = $(WGPU_DIR)/tmp/dawn.o
WGPU_ALL_LIBS = $(shell find $(WGPU_BUILD) -name "*.a" 2>/dev/null)
WGPU_SYS_LIBS = -lvulkan -ldl -lpthread -lX11

.PHONY: test clean

test: $(TEST_BIN)
	$(TEST_BIN)

$(TEST_BIN): $(TEST_OBJS)
	@mkdir -p tmp/test
	$(CXX) $(CXXFLAGS) $(TEST_OBJS) \
		$(WGPU_WRAPPER) \
		-Wl,--start-group $(WGPU_ALL_LIBS) -Wl,--end-group \
		$(WGPU_SYS_LIBS) \
		-o $@

$(OBJ_DIR)/%.o: $(TEST_DIR)/%.cpp
	@mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(WGPU_INC) -I$(TEST_DIR) -c $< -o $@

clean:
	rm -rf tmp/test/test_dawn tmp/obj/dawn
