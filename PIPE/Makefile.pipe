# PIPE Library Makefile
# Builds lib/pipe.a static library
#
# Exposes:
#   - sony::Decoder (via GEAR library)
#   - pipe::mods::* (processing modules)
#   - geos::Task (optimization)
#   - pqtr::Sink, pqtr::Tool, pqtr::Hold (infrastructure, header-only)

# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# OpenCV paths
OPENCV_ROOT = ./lib/opencv
OPENCV_INCLUDE = -I$(OPENCV_ROOT)/build \
                 -I$(OPENCV_ROOT)/modules/core/include \
                 -I$(OPENCV_ROOT)/modules/imgproc/include \
                 -I$(OPENCV_ROOT)/modules/imgcodecs/include
OPENCV_LIB = $(OPENCV_ROOT)/build/lib

# Include paths
INCLUDES = $(OPENCV_INCLUDE) \
           -I./inc \
           -I./inc/GEAR \
           -I./src/main/part/pipe \
           -I./src/main/part/geos

# Directories
SRC_DIR = src/main
OBJ_DIR = tmp/obj/pipe
LIB_DIR = lib

# GEAR library (via wire.sh symlink)
GEAR_A = $(LIB_DIR)/GEAR.a

# Pipe sources (HEAD/BODY/TAIL + internal)
PIPE_SRCS = $(SRC_DIR)/part/pipe/pipe.cpp \
            $(SRC_DIR)/part/pipe/view.cpp \
            $(SRC_DIR)/part/pipe/link.cpp

# Module sources (processing)
MODS_SRCS = $(SRC_DIR)/part/pipe/mods/color_matrix.cpp \
            $(SRC_DIR)/part/pipe/mods/exposure.cpp \
            $(SRC_DIR)/part/pipe/mods/white_balance.cpp \
            $(SRC_DIR)/part/pipe/mods/base_curve.cpp \
            $(SRC_DIR)/part/pipe/mods/tone_map.cpp \
            $(SRC_DIR)/part/pipe/mods/global_color.cpp \
            $(SRC_DIR)/part/pipe/mods/selective_color.cpp \
            $(SRC_DIR)/part/pipe/mods/geometric.cpp \
            $(SRC_DIR)/part/pipe/mods/detail.cpp \
            $(SRC_DIR)/part/pipe/mods/lut_curve.cpp \
            $(SRC_DIR)/part/pipe/mods/lut3d.cpp \
            $(SRC_DIR)/part/pipe/mods/split_tone.cpp \
            $(SRC_DIR)/part/pipe/mods/poly_color.cpp \
            $(SRC_DIR)/part/pipe/mods/local_tone.cpp

# Geos sources (optimization + loss metrics + serialization)
GEOS_SRCS = $(SRC_DIR)/part/geos/task.cpp \
            $(SRC_DIR)/part/geos/diff.cpp \
            $(SRC_DIR)/part/geos/spsa.cpp \
            $(SRC_DIR)/part/geos/aceo.cpp \
            $(SRC_DIR)/part/geos/edge.cpp \
            $(SRC_DIR)/part/geos/data.cpp \
            $(SRC_DIR)/part/geos/staged.cpp

# Object files
PIPE_OBJS = $(OBJ_DIR)/pipe/pipe.o \
            $(OBJ_DIR)/pipe/view.o \
            $(OBJ_DIR)/pipe/link.o

MODS_OBJS = $(OBJ_DIR)/mods/baseline.o \
            $(OBJ_DIR)/mods/color_matrix.o \
            $(OBJ_DIR)/mods/exposure.o \
            $(OBJ_DIR)/mods/white_balance.o \
            $(OBJ_DIR)/mods/base_curve.o \
            $(OBJ_DIR)/mods/tone_map.o \
            $(OBJ_DIR)/mods/sigmoid.o \
            $(OBJ_DIR)/mods/global_color.o \
            $(OBJ_DIR)/mods/selective_color.o \
            $(OBJ_DIR)/mods/geometric.o \
            $(OBJ_DIR)/mods/detail.o \
            $(OBJ_DIR)/mods/lut_curve.o \
            $(OBJ_DIR)/mods/lut3d.o \
            $(OBJ_DIR)/mods/hsv_lut.o \
            $(OBJ_DIR)/mods/split_tone.o \
            $(OBJ_DIR)/mods/poly_color.o \
            $(OBJ_DIR)/mods/local_tone.o

GEOS_OBJS = $(OBJ_DIR)/geos/task.o \
            $(OBJ_DIR)/geos/diff.o \
            $(OBJ_DIR)/geos/spsa.o \
            $(OBJ_DIR)/geos/aceo.o \
            $(OBJ_DIR)/geos/edge.o \
            $(OBJ_DIR)/geos/data.o \
            $(OBJ_DIR)/geos/staged.o \
            $(OBJ_DIR)/geos/jito.o

ALL_OBJS = $(PIPE_OBJS) $(MODS_OBJS) $(GEOS_OBJS)

# Target static library
PIPE_A = $(LIB_DIR)/pipe.a

.PHONY: all clean info

all: $(PIPE_A)

# Combine PIPE objects with GEAR library into pipe.a
$(PIPE_A): $(ALL_OBJS) $(GEAR_A) | $(LIB_DIR)
	@rm -rf $(OBJ_DIR)/merge && mkdir -p $(OBJ_DIR)/merge
	cd $(OBJ_DIR)/merge && ar x ../../../../$(GEAR_A)
	ar rcs $@ $(ALL_OBJS) $(OBJ_DIR)/merge/*.o
	@rm -rf $(OBJ_DIR)/merge
	@echo "Built: $@ (includes GEAR)"

# Pipe objects
$(OBJ_DIR)/pipe/%.o: $(SRC_DIR)/part/pipe/%.cpp | $(OBJ_DIR)/pipe
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Module objects
$(OBJ_DIR)/mods/%.o: $(SRC_DIR)/part/pipe/mods/%.cpp | $(OBJ_DIR)/mods
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Geos objects
$(OBJ_DIR)/geos/%.o: $(SRC_DIR)/part/geos/%.cpp | $(OBJ_DIR)/geos
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Directory creation
$(LIB_DIR):
	mkdir -p $(LIB_DIR)

$(OBJ_DIR)/pipe:
	mkdir -p $(OBJ_DIR)/pipe

$(OBJ_DIR)/mods:
	mkdir -p $(OBJ_DIR)/mods

$(OBJ_DIR)/geos:
	mkdir -p $(OBJ_DIR)/geos

clean:
	rm -rf $(OBJ_DIR) $(PIPE_A)

info:
	@echo "Target: $(PIPE_A)"
	@echo "Objects: $(ALL_OBJS)"
	@echo "GEAR: $(GEAR_A)"
	@echo "OpenCV: $(OPENCV_LIB)"
